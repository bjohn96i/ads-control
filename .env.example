# Copy to .env, or enter these as a Portainer stack's environment variables. Blank or unset
# settings keep their defaults; the Google ones are needed only for the thermostats and cameras.
# DATABASE_URL=postgresql+psycopg://adscontrol:adscontrol@localhost:5432/adscontrol
# REFOSS_HOST=192.168.4.254
# BIND_HOST=0.0.0.0
# PORT=8100

# Google Device Access, for the thermostats and cameras. Kept on the server, never sent to a browser.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SDM_PROJECT_ID=
# ALLOW_INSECURE_PIN=false

# Approximate location for outdoor temperature (city level). Sent only to Open-Meteo.
# WEATHER_LAT=
# WEATHER_LON=

# Pub/Sub subscription for camera events: projects/<cloud-project>/subscriptions/<id>
# GOOGLE_PUBSUB_SUBSCRIPTION=

# First names for the Maintenance page's "who's using this phone" buttons (a JSON list).
# HOUSEHOLD=["Alex", "Sam"]

# This server's own hostnames; requests for any other name are refused (a JSON list). Defaults to
# ["localhost"] only, so list the LAN IP and names people actually use.
# ALLOWED_HOSTS=["localhost", "127.0.0.1", "192.168.1.10", "home-server.local"]
