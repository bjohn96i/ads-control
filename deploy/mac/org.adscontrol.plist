<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.adscontrol</string>
  <!-- caffeinate -s keeps the Mac from sleeping on mains power; a sleeping Mac records nothing. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-s</string>
    <string>/Users/john/.local/bin/uv</string><string>run</string><string>adscontrol</string><string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/john/Documents/Development/ADS-Control/api</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/john/Documents/Development/ADS-Control/data/server.log</string>
  <key>StandardErrorPath</key><string>/Users/john/Documents/Development/ADS-Control/data/server.log</string>
</dict>
</plist>
